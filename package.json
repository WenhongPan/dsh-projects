{
  "name": "dsh-projects",
  "version": "0.2.0-alpha.2",
  "description": "Codex-like projects, searchable sessions, native folder picking, and sidebar organization for DeepSeek Harness.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/client.js",
    "src/index.js",
    "src/native-bridge.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/*.md",
    "docs/assets/demo.gif",
    "docs/assets/picker.webp",
    "docs/assets/create.webp",
    "docs/assets/native.webp",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check src/client.cjs && node --check src/index.js && node --check src/native-bridge.js && node --check src/core/default-workspace.cjs && node --check src/core/native-picker-result.cjs",
    "test": "node --test",
    "verify": "npm run check && npm run build && npm test",
    "prepack": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "projects",
    "sessions",
    "sidebar",
    "native-picker",
    "workspace",
    "plugin"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker-native": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
